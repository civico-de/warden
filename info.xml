<?xml version="1.0"?>
<extension key="warden" type="module">
  <file>warden</file>
  <name>warden</name>
  <description>OpenID Connect single sign-on for CiviCRM Standalone: discovery, PKCE, nonce and full ID-token signature validation, sub-keyed identity linking, provisioning and role mapping, with its own audit trail and rate limiting.</description>
  <license>Proprietary</license>
  <authors>
    <author>
      <name>Johannes Filter</name>
      <email>hi@jfilter.de</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/jfilter/warden</url>
    <url desc="Documentation">https://github.com/jfilter/warden</url>
    <url desc="Support">https://github.com/jfilter/warden/issues</url>
  </urls>
  <releaseDate>2026-08-14</releaseDate>
  <version>0.1.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <!-- 6.14, not lower, and the floor is measured rather than hopeful:
         `Civi\Authx\Standalone::loginSession()` gained session_regenerate_id()
         only in 6.13, and warden is verified against 6.14.1 and 6.15.6 (the
         civico fleet) plus 6.17.2 (the CI image). See "Verified against" in
         the README for the full symbol matrix. -->
    <ver>6.14</ver>
  </compatibility>
  <requires>
    <!-- standaloneusers is a HARD dependency and says so: warden establishes
         sessions through authx and denies password login through the
         civi.standalone.* events. Nothing here works on Drupal or WordPress. -->
    <ext>standaloneusers</ext>
    <ext>authx</ext>
    <ext>org.civicrm.afform</ext>
    <ext>org.civicrm.search_kit</ext>
  </requires>
  <php_compatibility mode="list">
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <smarty_compatibility mode="list">
    <ver>5</ver>
  </smarty_compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Warden\AutomaticUpgrader</upgrader>
  <civix>
    <namespace>CRM/Warden</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>menu-xml@1.0.0</mixin>
  </mixins>
</extension>
