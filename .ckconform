# Expected values for ckconform (the checker lives in the public civikitchen
# image; these values are ours and stay in this private repo).
license=Proprietary
npm_license=UNLICENSED
copyright=civico GmbH

# heraldChecks is herald's OWN invented hook; warden implements it to expose
# provider reachability and key-rollover health. Not a core hook, so ckconform
# cannot know it.
known_hooks=heraldChecks

# Raise once measured with ckcoverage; ratchet up, never down to make a red
# build green.
min_coverage=70

# Business hooks live in scan classes (AutoSubscriber/HookInterface); the
# classic function form is reserved for pre-boot/lifecycle/return-value hooks.
hook_style=listener

# Warden needs Composer dependencies before boot, lifecycle coverage and a
# dedicated real-browser Keycloak job in addition to the shared CI caller.
template_custom=.github/workflows/ci.yml -- Warden adds Composer, lifecycle and Keycloak E2E coverage
