{
    "name": "civico-de/warden",
    "description": "CiviCRM extension: OpenID Connect single sign-on for CiviCRM Standalone, with full ID-token validation, sub-keyed identity linking and its own audit trail.",
    "type": "civicrm-ext",
    "license": "proprietary",
    "authors": [
        {
            "name": "Johannes Filter",
            "email": "hi@jfilter.de"
        }
    ],
    "require": {
        "brick/math": "^0.13.1",
        "php": ">=8.4",
        "digitalcz/openid-connect": "^1.4",
        "symfony/http-client": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Civi\\Warden\\": "Civi/Warden/"
        },
        "psr-0": {
            "CRM_": "."
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Civi\\Warden\\": "tests/phpunit/Civi/Warden/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
